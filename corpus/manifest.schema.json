{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/bgremove/m0.corpus.v1.schema.json",
  "title": "Background removal M0 corpus manifest record",
  "description": "One JSON object per line. Paths are relative to the manifest directory.",
  "type": "object",
  "required": ["schema_version", "id", "input", "reference", "input_sha256", "reference_sha256", "input_decoded_sha256", "reference_decoded_sha256", "width", "height", "input_width", "input_height", "reference_width", "reference_height", "input_orientation", "reference_orientation", "input_alpha_present", "reference_alpha_present", "reference_png_bit_depth", "reference_png_color_type", "reference_png_color_metadata", "reference_alpha_levels", "tags", "split", "subject_policy", "shadow_policy", "prompt", "reference_created_at", "reference_tool", "reference_tool_version", "duplicate_group", "notes"],
  "properties": {
    "schema_version": {"const": "m0.corpus.v1"},
    "id": {"type": "string", "minLength": 1},
    "input": {"type": "string", "minLength": 1},
    "reference": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_decoded_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference_decoded_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1},
    "input_width": {"type": "integer", "minimum": 1}, "input_height": {"type": "integer", "minimum": 1},
    "reference_width": {"type": "integer", "minimum": 1}, "reference_height": {"type": "integer", "minimum": 1},
    "input_orientation": {"type": "string"}, "reference_orientation": {"type": "string"},
    "input_alpha_present": {"type": "boolean"}, "reference_alpha_present": {"type": "boolean"},
    "reference_png_bit_depth": {"type": ["integer", "null"], "minimum": 1},
    "reference_png_color_type": {"type": ["integer", "null"], "minimum": 0, "maximum": 6},
    "reference_png_color_metadata": {"type": "string", "minLength": 1},
    "reference_alpha_levels": {"type": "integer", "minimum": 1, "maximum": 256},
    "tags": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "split": {"enum": ["tune", "validation", "blind"]},
    "subject_policy": {"enum": ["primary-subject"]},
    "shadow_policy": {"enum": ["preserve-target-effects"]},
    "prompt": {"type": ["object", "null"]},
    "reference_created_at": {"type": ["string", "null"]}, "reference_tool": {"type": ["string", "null"]}, "reference_tool_version": {"type": ["string", "null"]},
    "duplicate_group": {"type": "string", "minLength": 1}, "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
