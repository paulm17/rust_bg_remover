@@ -94,0 +99,26 @@ impl Rmbg {
+
+    pub fn remove_background_with_stages(
+        &self,
+        original_img: &DynamicImage,
+    ) -> anyhow::Result<(DynamicImage, Vec<f32>, Vec<f32>, Vec<f32>, Vec<f32>)> {
+        let img = preprocess_image(original_img)?;
+        let tensor = img.clone().into_raw_vec();
+        let input = img.insert_axis(Axis(0));
+        let inputs = ort::inputs![ML_MODEL_INPUT_NAME => input.view()]?;
+        let outputs = self.model.run(inputs)?;
+        let output = outputs[ML_MODEL_OUTPUT_NAME].try_extract_tensor()?;
+        let output_view = output.view();
+        let full_output: Vec<f32> = output_view.iter().copied().collect();
+        let output_2d: ArrayView<f32, Dim<[usize; 2]>> = output_view.slice(s![0, 0, .., ..]);
+        eprintln!("M8 output shape={:?} samples={:?} min={:?} max={:?}", output_view.shape(), [output_2d[[0, 0]], output_2d[[0, 1]], output_2d[[1, 0]], output_2d[[1023, 1023]]], output_2d.iter().copied().fold(f32::INFINITY, f32::min), output_2d.iter().copied().fold(f32::NEG_INFINITY, f32::max));
+        let image = postprocess_image(&output_2d)?;
+        let resized = resize_rgba(&image, original_img.width(), original_img.height())?;
+        let mask = DynamicImage::ImageRgba8(ImageBuffer::<Rgba<u8>, Vec<u8>>::from_raw(original_img.width(), original_img.height(), resized).ok_or(anyhow!("invalid resized output"))?);
+        let restored_alpha = mask
+            .to_luma8()
+            .pixels()
+            .map(|pixel| pixel[0] as f32 / 255.0)
+            .collect();
+        let cutout = apply_mask(original_img, &mask);
+        Ok((cutout, tensor, full_output, restored_alpha, output_2d.iter().copied().collect()))
+    }
diff --git a/src/bin/m8_capture.rs b/src/bin/m8_capture.rs
new file mode 100644
index 0000000..52418de
--- /dev/null
+++ b/src/bin/m8_capture.rs
@@ -0,0 +1,33 @@
+use image::{DynamicImage, ImageBuffer, Rgba};
+use rmbg::Rmbg;
+use std::{env, fs};
+
+fn f32le(values: &[f32]) -> Vec<u8> {
+    values.iter().flat_map(|v| v.to_le_bytes()).collect()
+}
+
+fn main() -> anyhow::Result<()> {
+    let model = env::args().nth(1).expect("model");
+    let out = env::args().nth(2).expect("output");
+    ort::init_from(env::var("ORT_DYLIB").expect("ORT_DYLIB")).commit()?;
+    let mut input = ImageBuffer::<Rgba<u8>, Vec<u8>>::new(3, 2);
+    let values = [[0, 64, 255, 0], [128, 191, 26, 64], [51, 102, 204, 180], [255, 26, 0, 255], [77, 153, 230, 128], [204, 51, 102, 220]];
+    for (pixel, value) in input.pixels_mut().zip(values) { *pixel = Rgba(value); }
+    let image = DynamicImage::ImageRgba8(input.clone());
+    let session = Rmbg::new(model)?;
+    let public_cutout = session.remove_background(&image)?;
+    let (cutout, tensor, raw_full, restored_alpha, _raw_channel0) =
+        session.remove_background_with_stages(&image)?;
+    assert_eq!(public_cutout.to_rgba8().into_raw(), cutout.to_rgba8().into_raw());
+    fs::create_dir_all(&out)?;
+    let decoded = input
+        .pixels()
+        .flat_map(|pixel| pixel.0[..3].iter().map(|value| *value as f32 / 255.0))
+        .collect::<Vec<_>>();
+    fs::write(format!("{out}/decoded-rgb.f32le"), f32le(&decoded))?;
+    fs::write(format!("{out}/preprocessed-tensor.f32le"), f32le(&tensor))?;
+    fs::write(format!("{out}/raw-onnx-output.f32le"), f32le(&raw_full))?;
+    fs::write(format!("{out}/restored-alpha.f32le"), f32le(&restored_alpha))?;
+    fs::write(format!("{out}/final-straight-alpha-cutout.rgba"), cutout.to_rgba8().into_raw())?;
+    Ok(())
+}
